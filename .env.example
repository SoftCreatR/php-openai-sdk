# Project API key used by ordinary examples.
OPENAI_API_KEY=

# Organization admin key used only by examples/administration.
OPENAI_ADMIN_KEY=

# Optional request scoping.
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

# Optional bearer token used only by the Agents vault credential examples.
MCP_BEARER_TOKEN=

# Optional compatible endpoint overrides. The defaults are api.openai.com and /v1.
OPENAI_API_ORIGIN=
OPENAI_API_BASE_PATH=

# Workload identity federation examples.
OPENAI_IDENTITY_PROVIDER_ID=
OPENAI_SERVICE_ACCOUNT_ID=
OPENAI_EXTERNAL_OIDC_JWT=
OPENAI_CLIENT_CERT=
OPENAI_CLIENT_KEY=

# Signing secret for WebhookVerifier examples and integrations.
OPENAI_WEBHOOK_SECRET=
